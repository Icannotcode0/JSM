# Copy to .env and fill in. Values below are the local-dev defaults that
# config.Load() falls back to, except SESSION_SECRET which has no safe default.
#
# NOTE: config.Load() reads ".env" relative to the process working directory,
# so run the server from the directory holding this file (or export the vars).

APP_ENV=dev

# A bare ":8080" binds every interface; main.go forces it onto 127.0.0.1
# because JSM is local-only by design.
HTTP_PORT=:8080

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=jobtracker
MONGO_USERS_COLLECTION=users
MONGO_APPLICATIONS_COLLECTION=applications

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=jsm_session
CSRF_COOKIE_NAME=jsm_csrf

# HMAC key for signing CSRF tokens. Leave empty and the server generates a
# random one per boot (logged at startup) — safe, but outstanding tokens are
# invalidated on every restart. Set it to keep them stable:
#   openssl rand -base64 32
SESSION_SECRET=

COOKIE_DOMAIN=
# Keep false for local http. Note: the CSRF cookie currently hardcodes
# Secure:true regardless, which Safari rejects over http://localhost.
COOKIE_SECURE=false

# ---- Mail -------------------------------------------------------------------
# Local installs send nothing: new accounts are marked verified at signup and no
# transport is contacted, so the "nothing leaves your machine" promise holds.
# A hosted deployment sets this true and an address must be proved before the
# account is usable.
REQUIRE_EMAIL_VERIFICATION=false
MAIL_FROM=jsm@localhost

# ---- Rate limiting ----------------------------------------------------------
# Defaults to on. Disabling it removes throttling from login, signup, and
# change-password entirely.
RATE_LIMIT_ENABLED=true

# Empty means "use the TCP peer", which is correct for a direct connection and
# the only safe default. Behind a load balancer every user would otherwise share
# the balancer's address and the first burst would lock out everyone — so list
# the proxy CIDRs here when deploying behind one. Trusting too broadly is a
# silent bypass, so list only proxies you control.
TRUSTED_PROXIES=

# A platform header carrying a single authoritative client address, e.g.
# CF-Connecting-IP or Fly-Client-IP. Only read when the peer is trusted —
# anyone can set it, so it means nothing on its own.
CLIENT_IP_HEADER=

